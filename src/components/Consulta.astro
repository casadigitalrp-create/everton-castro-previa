---
import { Picture } from "astro:assets";
import { etapas } from "../data/etapas";
import { fundos } from "../data/fundos";
import Provisorio from "./Provisorio.astro";
---

<section id="consulta" aria-labelledby="consulta-titulo" class="fundo-marmore scroll-mt-20  text-texto">
  <div data-revelar class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="text-sm font-bold tracking-[0.18em] text-destaque uppercase">A consulta</p>
      <h2 id="consulta-titulo" class="mt-3 font-display text-4xl leading-tight font-semibold text-balance sm:text-5xl">
        Da primeira conversa ao acompanhamento, sem surpresas
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-texto-suave">
        Quatro passos, na ordem, para você saber sempre o que vem a seguir.<Provisorio rotulo="Modelo a confirmar" />
      </p>

      <ol class="mt-10 space-y-0">
        {
          etapas.map((etapa, i) => (
            <li class="relative flex gap-5 pb-8 last:pb-0">
              {i < etapas.length - 1 && (
                <span class="absolute top-12 left-[1.4rem] h-[calc(100%-2.5rem)] w-px bg-gradient-to-b from-ouro to-borda" aria-hidden="true" />
              )}
              <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-full bg-cta font-display text-2xl font-semibold text-cta-texto ring-4 ring-fundo-alt">
                {i + 1}
              </span>
              <div>
                <h3 class="font-display text-2xl font-semibold">{etapa.titulo}</h3>
                <p class="mt-1 leading-relaxed text-texto-suave">{etapa.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div data-inclinar class="overflow-hidden rounded-3xl border border-borda bg-fundo-alt shadow-xl shadow-ouro/20">
      <Picture
        src={fundos.colunasJonicas}
        alt="Ilustração conceitual de duas colunas jônicas em mármore claro, com detalhes dourados."
        formats={["avif", "webp"]}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 42vw, 92vw"
        loading="lazy"
        decoding="async"
        class="aspect-video w-full object-cover object-right"
      />
    </div>
  </div>
</section>
