---
import { faq } from "../data/faq";
import { whatsappLink } from "../data/site";
---

<section id="faq" aria-labelledby="faq-titulo" class="scroll-mt-20 bg-fundo text-texto">
  <div data-revelar class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[1fr_1.6fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="text-sm font-bold tracking-[0.18em] text-destaque uppercase">Dúvidas</p>
      <h2 id="faq-titulo" class="mt-3 font-display text-4xl leading-tight font-semibold text-balance sm:text-5xl">
        Perguntas frequentes
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-texto-suave">Não encontrou o que procurava? Pergunte direto.</p>
      <div data-spotlight class="mt-8 rounded-2xl border border-borda bg-fundo-alt p-6">
        <p class="font-display text-2xl font-semibold">Prefere perguntar direto?</p>
        <p class="mt-1 text-[15px] leading-snug text-texto-suave">Escreva pelo WhatsApp. Perguntar não gera nenhum compromisso.</p>
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-full bg-cta px-5 py-2.5 font-bold text-cta-texto transition-colors hover:bg-cta-hover"
        >
          Falar pelo WhatsApp<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </div>
    </div>

    <div class="divide-y divide-borda border-y border-borda">
      {
        faq.map((p) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-lg py-5 text-left font-display text-xl font-semibold [&::-webkit-details-marker]:hidden">
              {p.pergunta}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-texto/5 text-destaque transition-transform group-open:rotate-45" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </summary>
            <p class="pr-12 pb-6 leading-relaxed text-texto-suave">{p.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
