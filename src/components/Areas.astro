---
import { areas } from "../data/areas";
import Provisorio from "./Provisorio.astro";
---

<section id="areas" aria-labelledby="areas-titulo" class="scroll-mt-20 bg-fundo text-texto">
  <div data-revelar class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-bold tracking-[0.18em] text-destaque uppercase">Atendimento</p>
      <h2 id="areas-titulo" class="mt-3 font-display text-4xl leading-tight font-semibold text-balance sm:text-5xl">
        Cuidados que você encontra aqui
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-texto-suave">
        Atendimento clínico geral. Se o que você precisa pedir um especialista, eu explico e encaminho.<Provisorio rotulo="Serviços a confirmar" />
      </p>
    </div>

    <ul data-escalonar class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        areas.map((area) => (
          <li data-spotlight data-eleva class="rounded-3xl border border-borda bg-superficie p-6 shadow-sm">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-cta text-cta-texto">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={area.icone} />
              </svg>
            </span>
            <h3 class="mt-4 font-display text-2xl font-semibold">{area.nome}</h3>
            <p class="mt-2 leading-relaxed text-texto-suave">{area.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
