---
import { glossario } from "../data/glossario";
---

<section id="glossario" aria-labelledby="glossario-titulo" class="fundo-marmore scroll-mt-20  text-texto">
  <div data-revelar class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-end">
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-destaque uppercase">Odontologia traduzida</p>
        <h2 id="glossario-titulo" class="mt-3 font-display text-4xl leading-tight font-semibold text-balance sm:text-5xl">
          Termos de dentista em palavras simples
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-texto-suave">
          Se o dentista falar algo que você não entendeu, procure aqui. Definições gerais e informativas.
        </p>
      </div>
      <div>
        <label for="glossario-busca" class="font-bold">Buscar um termo</label>
        <input
          id="glossario-busca"
          type="search"
          autocomplete="off"
          placeholder="Ex.: profilaxia, cárie, canal"
          class="mt-2 block w-full rounded-xl border border-borda-forte bg-superficie px-4 py-3 placeholder:text-texto-sutil focus:border-destaque focus:outline-none focus-visible:outline-3 focus-visible:outline-foco"
        />
        <p id="glossario-status" class="mt-2 text-sm text-texto-sutil" role="status" aria-live="polite"></p>
      </div>
    </div>

    <ul id="glossario-lista" data-escalonar class="mt-10 grid gap-4 md:grid-cols-2">
      {
        glossario.map((item) => (
          <li data-termo={item.termo.toLowerCase()} data-texto={item.definicao.toLowerCase()}>
            <details data-spotlight class="group h-full rounded-2xl border border-borda bg-superficie p-5 open:border-destaque">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-lg text-left font-display text-xl font-semibold [&::-webkit-details-marker]:hidden">
                {item.termo}
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-texto/5 text-destaque transition-transform group-open:rotate-45" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-texto-suave">{item.definicao}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const busca = document.getElementById("glossario-busca") as HTMLInputElement | null;
  const lista = document.getElementById("glossario-lista");
  const status = document.getElementById("glossario-status");
  if (busca && lista) {
    const itens = [...lista.querySelectorAll<HTMLElement>("li[data-termo]")];
    // Tira acentos para "citacao" achar "citação".
    const limpar = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
    busca.addEventListener("input", () => {
      const termo = limpar(busca.value);
      let visiveis = 0;
      for (const item of itens) {
        const combina = !termo || limpar(`${item.dataset.termo} ${item.dataset.texto}`).includes(termo);
        item.hidden = !combina;
        if (combina) visiveis++;
      }
      if (status) {
        status.textContent = !termo
          ? ""
          : visiveis === 0
            ? "Nenhum termo encontrado. Pergunte na consulta: explico com exemplos."
            : `${visiveis} ${visiveis === 1 ? "termo encontrado" : "termos encontrados"}.`;
      }
    });
  }
</script>
