---
import { Picture } from "astro:assets";
import { fundos } from "../data/fundos";
import { site } from "../data/site";
import Provisorio from "./Provisorio.astro";

const principios = [
  { titulo: "Cuidado", texto: "Atendimento sem pressa, com atenção ao seu conforto." },
  {
    titulo: "Clareza",
    texto: "Explico o que encontrei, as opções e o que cada uma envolve.",
  },
  {
    titulo: "Respeito",
    texto: "Nada é feito sem a sua concordância, no seu ritmo.",
  },
];
---

<section id="sobre" aria-labelledby="sobre-titulo" class="fundo-marmore scroll-mt-20  text-texto">
  <div data-revelar class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="mx-auto w-full max-w-sm">
      <div data-inclinar class="overflow-hidden rounded-[2rem] border border-borda bg-fundo-alt shadow-xl shadow-ouro/20">
        <Picture
          src={fundos.retrato}
          alt="Monograma com as letras E e C em dourado, em um círculo de mármore. Espaço reservado para a foto do dentista."
          formats={["avif", "webp"]}
          widths={[400, 640, 1000]}
          sizes="(min-width: 1024px) 24rem, 80vw"
          loading="lazy"
          decoding="async"
          class="aspect-[5/6] w-full object-cover"
        />
      </div>
      <p class="mt-3 text-center text-sm text-texto-sutil">Espaço para a foto do dentista.<Provisorio rotulo="Foto a enviar" /></p>
    </div>

    <div>
      <p class="text-sm font-bold tracking-[0.18em] text-destaque uppercase">Sobre o dentista</p>
      <h2 id="sobre-titulo" class="mt-3 font-display text-4xl leading-tight font-semibold text-balance sm:text-5xl">
        Quem vai cuidar do seu sorriso
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-texto-suave">
        Sou {site.nome}, cirurgião-dentista formado pela {site.formacao}.<Provisorio rotulo="Ano a confirmar" />
        Inscrito no {site.cro}.<Provisorio rotulo="CRO a confirmar" /> Atendo com a convicção de que entender o
        próprio tratamento é um direito de quem senta na cadeira.
      </p>
      <p class="mt-3 leading-relaxed text-texto-suave">
        Aqui entram a trajetória, os cursos e a forma de trabalhar, escritos pelo próprio dentista.<Provisorio rotulo="Texto a enviar" />
      </p>

      <ul data-escalonar class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          principios.map((p) => (
            <li data-spotlight class="rounded-2xl border border-borda bg-superficie p-5">
              <p class="font-display text-2xl font-semibold text-destaque">{p.titulo}</p>
              <p class="mt-1 text-[15px] leading-snug text-texto-suave">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
