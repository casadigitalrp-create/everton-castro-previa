---
import { motivos } from "../data/preparar";
import { site } from "../data/site";
---

<section id="preparar" aria-labelledby="preparar-titulo" class="scroll-mt-20 bg-fundo text-texto">
  <div data-revelar class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-bold tracking-[0.18em] text-destaque uppercase">Ferramenta</p>
      <h2 id="preparar-titulo" class="mt-3 font-display text-4xl leading-tight font-semibold text-balance sm:text-5xl">
        Prepare sua consulta
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-texto-suave">
        Escolha o motivo da visita e veja uma lista geral do que levar e de perguntas para fazer. Marque o que você já
        tem e, se quiser, leve o resumo pelo WhatsApp. Nada do que você marca aqui é guardado: tudo fica só no seu
        aparelho.
      </p>
    </div>

    <div id="preparar-app" data-whatsapp={site.whatsapp} class="mt-10">
      <fieldset>
        <legend class="font-display text-2xl font-semibold">1. Qual é o motivo da visita?</legend>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            motivos.map((s) => (
              <label class="relative cursor-pointer rounded-2xl border-2 border-borda bg-superficie p-4 transition-colors hover:border-destaque has-[:checked]:border-destaque has-[:checked]:bg-fundo-alt has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-foco">
                <input type="radio" name="situacao" value={s.id} class="peer sr-only" />
                <span class="block font-bold">{s.nome}</span>
                <span class="mt-1 block text-sm text-texto-suave">{s.exemplo}</span>
                <span class="absolute top-3 right-3 hidden h-6 w-6 place-items-center rounded-full bg-cta text-cta-texto peer-checked:grid" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <p id="preparar-vazio" class="mt-8 hidden rounded-2xl border border-dashed border-borda-forte p-6 text-texto-suave">
        Escolha um motivo acima para ver a lista.
      </p>

      {
        motivos.map((s) => (
          <div data-painel={s.id} data-nome={s.nome} class="mt-10 rounded-3xl border border-borda bg-superficie p-6 shadow-sm sm:p-8">
            {s.aviso && (
              <p class="mb-6 rounded-2xl border border-aviso-borda bg-aviso-fundo p-4 text-[15px] leading-snug font-semibold text-aviso-texto" role="note">
                {s.aviso}
              </p>
            )}
            <div class="grid gap-10 lg:grid-cols-2">
              <div>
                <h3 class="font-display text-2xl font-semibold">2. O que levar ou informar</h3>
                <p class="mt-1 text-sm text-texto-sutil">Marque o que você já tem. Se faltar algo, tudo bem.</p>
                <ul class="mt-4 space-y-2.5">
                  {s.itens.map((doc) => (
                    <li>
                      <label class="flex cursor-pointer items-start gap-3 rounded-xl p-2 hover:bg-fundo-alt">
                        <input type="checkbox" data-doc value={doc} class="mt-1 h-5 w-5 shrink-0 cursor-pointer rounded accent-[#7a5a1e]" />
                        <span class="leading-snug">{doc}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="font-display text-2xl font-semibold">3. Perguntas para fazer na consulta</h3>
                <ul class="mt-4 space-y-3">
                  {s.perguntas.map((p) => (
                    <li class="flex gap-3 leading-snug">
                      <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-solucao-fundo text-sm font-bold text-solucao-texto" aria-hidden="true">?</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 flex flex-col gap-4 border-t border-borda pt-6 sm:flex-row sm:items-center sm:justify-between">
              <p data-contagem class="font-bold" role="status" aria-live="polite">Você marcou 0 de {s.itens.length}.</p>
              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  data-enviar
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center justify-center rounded-full bg-cta px-6 py-3 text-center font-bold text-cta-texto transition-colors hover:bg-cta-hover"
                >
                  Levar este resumo ao WhatsApp<span class="sr-only"> (abre em nova aba)</span>
                </a>
                <button
                  type="button"
                  data-copiar
                  class="inline-flex min-h-11 items-center justify-center rounded-full border border-borda-forte px-6 py-3 font-bold transition-colors hover:border-destaque hover:text-destaque"
                >
                  Copiar resumo
                </button>
              </div>
            </div>
            <p data-status class="mt-3 hidden text-sm font-semibold text-solucao-texto" role="status"></p>
          </div>
        ))
      }

      <p class="mt-6 text-sm leading-relaxed text-texto-sutil">
        Lista geral e informativa. Cada pessoa tem particularidades e o dentista pode pedir outros dados ou exames.
        Esta ferramenta não faz diagnóstico nem substitui o exame feito por um profissional.
      </p>
    </div>
  </div>
</section>

<script>
  const app = document.getElementById("preparar-app");
  if (app) {
    const numero = app.dataset.whatsapp ?? "";
    const paineis = [...app.querySelectorAll<HTMLElement>("[data-painel]")];
    const radios = [...app.querySelectorAll<HTMLInputElement>('input[name="situacao"]')];
    const vazio = document.getElementById("preparar-vazio");

    const resumo = (painel: HTMLElement) => {
      const todos = [...painel.querySelectorAll<HTMLInputElement>("[data-doc]")];
      const tenho = todos.filter((c) => c.checked).map((c) => c.value);
      const falta = todos.filter((c) => !c.checked).map((c) => c.value);
      const linhas = [
        `Olá, Dr. Everton! Quero agendar uma consulta. Motivo: ${painel.dataset.nome ?? "outra área"}.`,
        tenho.length ? `Já separei:\n- ${tenho.join("\n- ")}` : "Ainda não separei nada.",
        falta.length ? `Ainda falta:\n- ${falta.join("\n- ")}` : "Tenho todos os itens da lista.",
      ];
      return linhas.join("\n\n");
    };

    const atualizar = (painel: HTMLElement) => {
      const todos = [...painel.querySelectorAll<HTMLInputElement>("[data-doc]")];
      const marcados = todos.filter((c) => c.checked).length;
      const contagem = painel.querySelector("[data-contagem]");
      if (contagem) contagem.textContent = `Você marcou ${marcados} de ${todos.length}.`;
      const enviar = painel.querySelector<HTMLAnchorElement>("[data-enviar]");
      if (enviar) enviar.href = `https://wa.me/${numero}?text=${encodeURIComponent(resumo(painel))}`;
    };

    const mostrar = (id: string | null) => {
      paineis.forEach((p) => {
        p.hidden = p.dataset.painel !== id;
      });
      vazio?.classList.toggle("hidden", id !== null);
    };

    paineis.forEach((painel) => {
      atualizar(painel);
      painel.addEventListener("change", () => atualizar(painel));
      painel.querySelector("[data-copiar]")?.addEventListener("click", async () => {
        const status = painel.querySelector<HTMLElement>("[data-status]");
        try {
          await navigator.clipboard.writeText(resumo(painel));
          if (status) status.textContent = "Resumo copiado. Você pode colar em qualquer conversa.";
        } catch {
          if (status) status.textContent = "Não foi possível copiar. Use o botão do WhatsApp.";
        }
        status?.classList.remove("hidden");
      });
    });
    radios.forEach((radio) => radio.addEventListener("change", () => mostrar(radio.value)));
    // Com JavaScript, começa sem lista aberta; sem JavaScript, todas as listas ficam visíveis.
    mostrar(radios.find((r) => r.checked)?.value ?? null);
  }
</script>
